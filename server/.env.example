# Gemini API key for alt-text generation
GEMINI_API_KEY=your_gemini_api_key

# Lightweight model for fast, efficient inference
GEMINI_MODEL=gemini-3.8-flash

# Server port
PORT=5000

# Rate limiting (requests per minute)
GEMINI_RPM_LIMIT=10

# Maximum images to send to Gemini per audit
GEMINI_IMAGE_LIMIT_PER_AUDIT=10
